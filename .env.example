# Supabase public connection settings. Prefer the publishable key for new projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary fallback while the existing FPVSuperApp project still uses a legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy direct-Supabase analytics adapter, retained for local tests only.
# Do not configure these with the shared FPVSuperApp production project: a Supabase
# secret key has full-project access and bypasses RLS. Production must use the
# restricted ingest path defined in docs/designs/fpvsuperapp-shared-supabase-decision.md.
# They intentionally do not fall back to NEXT_PUBLIC_*, SUPABASE_URL, SUPABASE_SECRET_KEY,
# or SUPABASE_SERVICE_ROLE_KEY from another application.
FPVHELPER_ANALYTICS_SUPABASE_URL=
FPVHELPER_ANALYTICS_SUPABASE_SECRET_KEY=

# Comma-separated production hostnames accepted by POST /api/events.
ANALYTICS_ALLOWED_HOSTNAMES=

# Analytics sends only when both this opt-in and the production environment marker are set.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_ANALYTICS_ENV=

# Optional public build override. By default next.config.ts generates package version + commit SHA.
# Never put a secret here.
NEXT_PUBLIC_APP_VERSION=

# Workstation ingest tokens are installed locally with setAnalyticsIngestToken(); no shared env token exists.
