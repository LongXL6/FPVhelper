# Supabase public connection settings. Prefer the publishable key for new projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary fallback while the existing FPVSuperApp project still uses a legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics server URL for the independent FPVHelper Supabase project.
SUPABASE_URL=

# Server-only Supabase secret key. Prefer a dedicated, revocable sb_secret_ key.
SUPABASE_SECRET_KEY=

# Deprecated compatibility fallback only; migrate legacy service_role usage before the end of 2026.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated production hostnames accepted by POST /api/events.
ANALYTICS_ALLOWED_HOSTNAMES=

# Analytics sends only when both this opt-in and the production environment marker are set.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_ANALYTICS_ENV=

# Public release/build identifier attached to every event; never put a secret here.
NEXT_PUBLIC_APP_VERSION=

# Workstation ingest tokens are installed locally with setAnalyticsIngestToken(); no shared env token exists.
